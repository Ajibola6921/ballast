# Copy to deploy/.env.prod and fill in. Never commit the filled-in file.
# Generate every secret below with: openssl rand -hex 32

# --- Hosting -------------------------------------------------------------------------------
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
POSTGRES_PASSWORD=

# --- Network -------------------------------------------------------------------------------
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# Any funded account; reads are simulated against it and never signed.
STELLAR_SIMULATION_SOURCE=
NODE_OPTIONS=--network-family-autoselection-attempt-timeout=5000

# --- Contracts (from .env.mainnet-deploy) --------------------------------------------------
REGISTRY_CONTRACT_ID=
PRICE_GUARD_CONTRACT_ID=
# Lending contracts: leave empty until they are deployed.
PLEDGE_VAULT_CONTRACT_ID=
CREDIT_LINE_CONTRACT_ID=
EXIT_DESK_CONTRACT_ID=
REPO_DVP_CONTRACT_ID=
USDC_SAC_CONTRACT_ID=

# --- API -----------------------------------------------------------------------------------
CONSOLE_ORIGIN=https://console.example.com
JWT_SIGNING_SECRET=
# A Stellar secret key (S...) used only to sign SEP-10 challenges. It never needs funding.
SEP10_SERVER_SECRET=
SEP10_HOME_DOMAIN=console.example.com
SEP10_WEB_AUTH_DOMAIN=api.example.com
WEBHOOK_SECRET_KEY=
API_KEY_SECRET_KEY=
# KYB + OFAC sanctions gate in front of lending routes (default true in production).
COMPLIANCE_ENFORCED=true

# --- Operator keys: use Vault or KMS; "local" is refused in production -----------------------
PRICE_PUBLISHER_SIGNER_MODE=vault
KEEPER_SIGNER_MODE=vault
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
PRICE_PUBLISHER_VAULT_KEY_NAME=
KEEPER_VAULT_KEY_NAME=

# --- Price sources (see scripts/real-sources.env) --------------------------------------------
REDSTONE_RPC_URL=https://mainnet.sorobanrpc.com
REDSTONE_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
REDSTONE_FEED_CONTRACT_IDS='{"CETES":"CCYGBQZ5JKE2TGK2XNNVIZRKFEIT27NZADS3XJFSO4CCIH3LHIUP34LG","USTRY":"CAEGYZFAJ3HLSDBUIVJ77SK5HLLS4MPE4LO5OB2W3L2TEDMAS6RCTMZ4","TESOURO":"CAO3JDDO52PV5SNIR4WRLBNTE72CY6B4JO5PNSSRRM4TC5DZ5X5ZSJVC"}'
# Set to false to watch real readings without publishing anything on-chain (shadow run).
PRICE_GUARD_PUBLISH=true

# --- Alerts ----------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
OPERATOR_MIN_XLM=20

{
  "name": "ballast",
  "private": true,
  "description": "Collateral and liquidity network for Stellar RWAs.",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "node init && turbo run build",
    "dev": "node init && turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @ballast/db migrate"
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

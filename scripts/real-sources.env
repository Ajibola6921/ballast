# Real price sources for the test asset RWA1 on testnet/local. RWA1 is a token this repo issues
# itself, so it has no market of its own; it is priced as Etherfuse's real USTRY bond, from both
# of Ballast's independent sources:
#   - issuer NAV: Etherfuse's public price API, queried under the symbol USTRY
#   - oracle:     RedStone's USTRY feed contract on Stellar MAINNET (RedStone publishes no RWA
#                 feeds on testnet), read through a mainnet RPC
# Sourced by scripts/dev-setup.sh and scripts/e2e-smoke.sh.
REDSTONE_RPC_URL=https://mainnet.sorobanrpc.com
REDSTONE_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
REDSTONE_FEED_CONTRACT_IDS='{"RWA1":"CAEGYZFAJ3HLSDBUIVJ77SK5HLLS4MPE4LO5OB2W3L2TEDMAS6RCTMZ4"}'
ISSUER_NAV_SYMBOLS='{"RWA1":"USTRY"}'
